pkgname=k3s-docker-registry
pkgver=1.0
pkgrel=1
arch=('any')
pkgdesc=""
url="https://aur.archlinux.org/packages/k3s-docker-registry"
license=('GPL')
depends=('k3s')
source=('docker-registry.yaml' 'registries.yaml')

package() {
    install -Dm755 "${srcdir}/docker-registry.yaml" "${pkgdir}/usr/share/k3s-docker-registry/"
    install -Dm755 "${srcdir}/registries.yaml" "${pkgdir}/etc/rancher/k3s/registries.yaml"
}

